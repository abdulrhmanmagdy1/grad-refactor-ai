# Training and local-inference environment (.venv-train), never the core .venv.
# Resolved on 2026-10-20 into training/requirements-cuda.txt (the exact lock) with:
#   python -m uv pip install --python .venv-train/Scripts/python.exe --torch-backend cu126 \
#       "torch==2.14.1" transformers peft accelerate datasets huggingface_hub safetensors
# torch comes from the official PyTorch CUDA 12.6 index (https://download.pytorch.org/whl/cu126);
# the rest from PyPI. Use another CUDA backend only after testing it on the target machine.
torch==2.14.1
