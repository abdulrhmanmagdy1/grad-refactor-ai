!.env.example
# Local run database (history + user-submitted code stays local).
runs.sqlite3*
# Generated/raw data stays local, but the authored curated dataset and its
# manifest are deliverables and are tracked (validated by CI, hashed by
# RELEASE_MANIFEST.json).
data/*
!data/curated.jsonl
!data/manifest.json
models/
runs/
*.log
*.safetensors
*.pt
*.pth
*.bin
*.ckpt
*.gguf
configs/*.local.json
node_modules/
dist/
# Keep the built web UI bundle in the repository: FastAPI serves it from /
!frontend/dist/
!frontend/dist/**
# Blind-review answer key stays private until every rating is collected.
experiments/review/review_key.csv
